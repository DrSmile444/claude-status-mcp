{
  "name": "claude-status-mcp",
  "version": "0.3.1",
  "description": "CLI and MCP server for retrieving current Claude OAuth usage.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js"
  },
  "bin": {
    "claude-status-mcp": "./dist/cli.js"
  },
  "author": "Dmytro Vakulenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrSmile444/claude-status-mcp.git"
  },
  "homepage": "https://github.com/DrSmile444/claude-status-mcp#readme",
  "bugs": {
    "url": "https://github.com/DrSmile444/claude-status-mcp/issues"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts --mcp",
    "prepack": "npm run build",
    "start": "node dist/cli.js --mcp",
    "status": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "anthropic",
    "mcp",
    "usage"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
